{
  "id": "gradient-glow",
  "name": "Gradient outline glow",
  "category": "hover",
  "target": "element",
  "params": [
    {
      "key": "palette",
      "label": "Colors",
      "type": "palette",
      "default": "rainbow"
    },
    {
      "key": "trigger",
      "label": "When",
      "type": "select",
      "default": "hover",
      "options": [
        "hover",
        "loop"
      ]
    },
    {
      "key": "spread",
      "label": "Spread",
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "key": "blur",
      "label": "Blur",
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "key": "opacity",
      "label": "Strength",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "duration",
      "label": "Cycle",
      "type": "number",
      "default": 20000,
      "min": 2000,
      "max": 60000,
      "step": 1000,
      "unit": "ms"
    }
  ],
  "respectsReducedMotion": true,
  "detect": {
    "keyframes": [
      "rainbow-glowing"
    ]
  },
  "origin": {
    "repo": "fairy/fairy-shop",
    "file": "src/index.css (.rainbow-glow-card, Glitter Groovy Rainbow theme)"
  },
  "alsoIn": {
    "loop": {
      "trigger": "loop"
    }
  }
}
