{
  "id": "rainbow-button",
  "name": "Rainbow gradient button",
  "category": "loop",
  "target": "element",
  "params": [
    {
      "key": "alpha",
      "label": "Opacity",
      "type": "number",
      "default": 0.6,
      "min": 0.1,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "number",
      "default": 15000,
      "min": 2000,
      "max": 40000,
      "step": 500,
      "unit": "ms"
    }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "web-tools-persona-quest (live site)",
    "file": ".rainbow-gradient-button"
  }
}
