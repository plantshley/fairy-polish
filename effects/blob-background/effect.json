{
  "id": "blob-background",
  "name": "Floating blobs background",
  "category": "background",
  "target": "background",
  "params": [
    {
      "key": "palette",
      "label": "Colors",
      "type": "palette",
      "default": "teal-green"
    },
    {
      "key": "count",
      "label": "Blobs",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "key": "pattern",
      "label": "Placement",
      "type": "select",
      "default": "classic",
      "options": [
        "classic",
        "corners",
        "scattered",
        "ring",
        "diagonal",
        "cluster"
      ]
    },
    {
      "key": "spread",
      "label": "Spread",
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 1.6,
      "step": 0.05,
      "unit": "×"
    },
    {
      "key": "randomness",
      "label": "Randomness",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "travel",
      "label": "Travel",
      "type": "number",
      "default": 8,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%"
    },
    {
      "key": "seed",
      "label": "Shuffle",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "key": "opacity",
      "label": "Strength",
      "type": "number",
      "default": 0.7,
      "min": 0.1,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "blur",
      "label": "Blur",
      "type": "number",
      "default": 60,
      "min": 10,
      "max": 140,
      "step": 5,
      "unit": "px"
    },
    {
      "key": "size",
      "label": "Blob size",
      "type": "number",
      "default": 1,
      "min": 0.4,
      "max": 2,
      "step": 0.05,
      "unit": "×"
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "×"
    },
    {
      "key": "glow",
      "label": "Center glow",
      "type": "boolean",
      "default": true
    }
  ],
  "respectsReducedMotion": true,
  "detect": {
    "keyframes": [
      "gbFloat1",
      "gbFloat2",
      "gbFloat3",
      "advFloat1",
      "advFloat2",
      "advFloat3"
    ]
  },
  "origin": {
    "repo": "SDSHC-games-hub and SDSHC-check-in",
    "file": "games-hub src/styles/advanced.css (.adv-gradient-sphere-*); check-in src/ui/ui.css (.gb-sphere-*, .gb-glow) and GradientBackground.jsx"
  }
}
