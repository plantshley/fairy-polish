{
  "id": "twinkle-background",
  "name": "Twinkling sparkles background",
  "category": "background",
  "target": "background",
  "textMask": true,
  "layerOpacity": true,
  "params": [
    {
      "key": "color",
      "label": "Sparkle color",
      "type": "color",
      "default": "#ffd1f0"
    },
    {
      "key": "count",
      "label": "Sparkles",
      "type": "number",
      "default": 30,
      "min": 5,
      "max": 80,
      "step": 1
    },
    {
      "key": "emojis",
      "label": "Floating emojis",
      "type": "text",
      "default": ""
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "type": "number",
      "default": 1,
      "min": 0.05,
      "max": 1,
      "step": 0.05
    }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "fairy/fairy-shop",
    "file": "src/components/AnimatedBackground.jsx"
  }
}
