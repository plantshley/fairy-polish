{
  "id": "pixel-stars",
  "name": "Parallax pixel stars",
  "category": "background",
  "target": "background",
  "textMask": true,
  "layerOpacity": true,
  "alsoIn": {
    "loop": {}
  },
  "params": [
    {
      "key": "color",
      "label": "Star color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "density",
      "label": "Density",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "step": 0.1
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 5,
      "step": 0.1
    },
    {
      "key": "direction",
      "label": "Drift",
      "type": "select",
      "default": "up",
      "options": [
        "up",
        "down",
        "left",
        "right"
      ]
    },
    {
      "key": "sky",
      "label": "Night sky behind",
      "type": "boolean",
      "default": true
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "type": "number",
      "default": 1,
      "min": 0.05,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "seed",
      "label": "Layout seed",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 50,
      "step": 1
    }
  ],
  "respectsReducedMotion": true,
