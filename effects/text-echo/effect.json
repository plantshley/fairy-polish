{
  "id": "text-echo",
  "name": "Blurred text echo",
  "category": "loop",
  "target": "element",
  "layerOpacity": true,
  "alsoIn": {
    "hover": { "trigger": "hover" }
  },
  "params": [
    { "key": "trigger", "label": "Show", "type": "select", "default": "always", "options": ["always", "hover"] },
    { "key": "color", "label": "Echo color", "type": "color", "default": "currentcolor" },
    { "key": "blur", "label": "Blur", "type": "number", "default": 8, "min": 0, "max": 40, "step": 1, "unit": "px" },
    { "key": "scale", "label": "Scale", "type": "number", "default": 1.04, "min": 0.8, "max": 1.6, "step": 0.01 },
    { "key": "x", "label": "Offset x", "type": "number", "default": 0, "min": -40, "max": 40, "step": 1, "unit": "px" },
    { "key": "y", "label": "Offset y", "type": "number", "default": 0, "min": -40, "max": 40, "step": 1, "unit": "px" },
    { "key": "pulse", "label": "Pulse", "type": "boolean", "default": false },
    { "key": "duration", "label": "Pulse time", "type": "number", "default": 3000, "min": 500, "max": 10000, "step": 100, "unit": "ms" },
    { "key": "opacity", "label": "Opacity", "type": "number", "default": 0.8, "min": 0.05, "max": 1, "step": 0.05 }
  ],
  "respectsReducedMotion": true,
  "origin": { "builtin": true }
}
