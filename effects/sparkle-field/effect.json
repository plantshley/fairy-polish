{
  "id": "sparkle-field",
  "name": "Star sparkle field",
  "category": "background",
  "target": "background",
  "textMask": true,
  "layerOpacity": true,
  "params": [
    {
      "key": "palette",
      "label": "Colors",
      "type": "palette",
      "default": "flower"
    },
    {
      "key": "spread",
      "label": "Spread",
      "type": "number",
      "default": 0.6,
      "min": 0.1,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "min": 0.25,
      "max": 3,
      "step": 0.05,
      "unit": "×"
    },
    {
      "key": "density",
      "label": "Stars",
      "type": "number",
      "default": 30,
      "min": 8,
      "max": 160,
      "step": 2
    },
    {
      "key": "size",
      "label": "Star size",
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 14,
      "step": 1,
      "unit": "px"
    },
    {
      "key": "origin",
      "label": "Burst from",
      "type": "select",
      "default": "center",
      "options": [
        "center",
        "scattered"
      ]
    },
    {
      "key": "bleed",
      "label": "Overflow",
      "type": "number",
      "default": 32,
      "min": 0,
      "max": 240,
      "step": 8,
      "unit": "px"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "type": "number",
      "default": 1,
      "min": 0.05,
      "max": 1,
      "step": 0.05
    }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "SDSHC-master-dashboard",
    "file": "src/components/HeroSparkles/HeroSparkles.jsx (+ .css)"
  }
}
