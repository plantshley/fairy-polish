{
  "id": "glow",
  "name": "Glow",
  "category": "hover",
  "target": "element",
  "params": [
    {
      "key": "color",
      "label": "Color",
      "type": "color",
      "default": "#c2569b"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "number",
      "default": 18,
      "min": 2,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "number",
      "default": 250,
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "ms"
    }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "builtin": true
  }
}
