{
  "id": "button-shine",
  "name": "Button shine sweep",
  "category": "hover",
  "target": "element",
  "textMask": true,
  "params": [
    {
      "key": "color",
      "label": "Color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "strength",
      "label": "Strength",
      "type": "number",
      "default": 0.15,
      "min": 0.05,
      "max": 0.8,
      "step": 0.05
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "number",
      "default": 700,
      "min": 200,
      "max": 2000,
      "step": 50,
      "unit": "ms"
    }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "SDSHC-master-dashboard",
    "file": "src/components/NavButton/NavButton.css (.nav-tab-btn-shine)"
  }
}
