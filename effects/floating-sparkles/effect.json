      "label": "Glow size",
      "type": "number",
      "default": 6,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "key": "size",
      "label": "Largest size",
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 20,
      "step": 0.5,
      "unit": "px"
    },
    {
      "key": "rise",
      "label": "Rise",
      "type": "number",
      "default": 15,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1
