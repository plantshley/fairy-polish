{
  "id": "floating-sparkles",
  "name": "Floating sparkles",
  "category": "background",
  "target": "background",
  "textMask": true,
  "layerOpacity": true,
  "alsoIn": {
    "loop": {}
  },
  "params": [
    {
      "key": "count",
      "label": "Sparkles",
      "type": "number",
      "default": 40,
      "min": 1,
      "max": 200,
      "step": 1
    },
    {
      "key": "color",
      "label": "Color",
      "type": "color",
      "default": "rgba(255, 255, 255, 0.95)"
    },
    {
      "key": "glowColor",
      "label": "Glow color",
      "type": "color",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
