{
  "id": "gradient-text",
  "name": "Animated gradient text",
  "category": "loop",
  "target": "element",
  "params": [
    { "key": "palette", "label": "Colors", "type": "palette", "default": "cyan-purple" },
    { "key": "angle", "label": "Angle", "type": "number", "default": 90, "min": 0, "max": 360, "step": 5, "unit": "deg" },
    { "key": "duration", "label": "Duration", "type": "number", "default": 8000, "min": 1000, "max": 20000, "step": 500, "unit": "ms" }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "web-tools-persona-quest (live site) and SDSHC-games-hub",
    "file": ".animate-gradient title (persona quest); src/styles/intro.css .intro-btn-label (games-hub)"
  }
}
