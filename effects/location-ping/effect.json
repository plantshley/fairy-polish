{
  "id": "location-ping",
  "name": "Location ping ripple",
  "category": "loop",
  "target": "element",
  "alsoIn": { "hover": { "trigger": "hover" } },
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "#ff4d6d" },
    { "key": "trigger", "label": "When", "type": "select", "default": "loop", "options": ["loop", "hover"] },
    { "key": "rings", "label": "Rings", "type": "number", "default": 3, "min": 1, "max": 6, "step": 1 },
    { "key": "reach", "label": "Reach", "type": "number", "default": 2.5, "min": 1.2, "max": 6, "step": 0.1 },
    { "key": "width", "label": "Ring width", "type": "number", "default": 2, "min": 1, "max": 8, "step": 0.5, "unit": "px" },
    { "key": "fill", "label": "Filled rings", "type": "boolean", "default": false },
    { "key": "pin", "label": "Center dot", "type": "boolean", "default": false },
    { "key": "duration", "label": "Duration", "type": "number", "default": 2400, "min": 600, "max": 8000, "step": 100, "unit": "ms" }
  ],
  "respectsReducedMotion": true,
  "origin": { "builtin": true }
}
