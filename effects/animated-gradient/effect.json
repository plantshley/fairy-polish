{
  "id": "animated-gradient",
  "name": "Animated gradient background",
  "category": "background",
  "target": "background",
  "params": [
    { "key": "palette", "label": "Colors", "type": "palette", "default": "pastel" },
    { "key": "angle", "label": "Angle", "type": "number", "default": 135, "min": 0, "max": 360, "step": 5, "unit": "deg" },
    { "key": "duration", "label": "Duration", "type": "number", "default": 15000, "min": 2000, "max": 40000, "step": 500, "unit": "ms" }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "fairy/fairy-shop",
    "file": "src/index.css (.animated-gradient-bg)"
  }
}
