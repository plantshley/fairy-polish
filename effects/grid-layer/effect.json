{
  "id": "grid-layer",
  "name": "Subtle grid layer",
  "category": "background",
  "target": "background",
  "textMask": true,
  "params": [
    {
      "key": "color",
      "label": "Line color",
      "type": "color",
      "default": "#5b7a8c"
    },
    {
      "key": "opacity",
      "label": "Strength",
      "type": "number",
      "default": 0.15,
      "min": 0.02,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "size",
      "label": "Cell size",
      "type": "number",
      "default": 40,
      "min": 8,
      "max": 160,
      "step": 2,
      "unit": "px"
    },
    {
      "key": "line",
      "label": "Line width",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 0.5,
      "unit": "px"
    },
    {
      "key": "noise",
      "label": "Grain",
      "type": "boolean",
      "default": false
    },
    {
      "key": "fade",
      "label": "Fade edges",
      "type": "boolean",
      "default": false
    }
  ],
  "respectsReducedMotion": true,
  "origin": {
    "repo": "SDSHC-games-hub and SDSHC-check-in",
    "file": "games-hub src/styles/advanced.css (.adv-gradient-grid); check-in src/ui/ui.css (.gb-grid, .gb-noise)"
  }
}
